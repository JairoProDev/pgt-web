# Site URL — use http://localhost:3000 locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager (same as WordPress EN)
NEXT_PUBLIC_GTM_ID=GTM-K8SZBJM5

# Non-prod preview — prefer next.perugrandtravel.com with NEXT_PUBLIC_ENV=next
# (also accepts beta|preview). Leave unset on real www production.
# NEXT_PUBLIC_ENV=next

# Review profile links (cutover prod)
NEXT_PUBLIC_TRIPADVISOR_URL=https://www.tripadvisor.com/Attraction_Review-g294314-d3335204-Reviews-Peru_Grand_Travel-Cusco_Cusco_Region.html
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://www.google.com/maps/search/?api=1&query=Peru+Grand+Travel+Av+El+Sol+948+Cusco+Peru

# Optional TrustIndex live widget (same as WP) — set widget ID from Ops
# NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID=

# Payload CMS (see docs/PAYLOAD.md)
# Local Docker — do not replace this with vercel env pull
# DATABASE_URL=postgresql://pgt:pgt@127.0.0.1:5434/pgt
# PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
# CONTENT_SOURCE=json
# Neon sidecar: vercel env pull .env.neon --environment=production --yes
