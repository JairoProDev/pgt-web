# Copy to pgt-web/.env.mcp (gitignored) and fill values.
# See docs/INTEGRACIONES.md for GCP setup (~15 min one-time).

# Google Cloud project where APIs are enabled
GOOGLE_PROJECT_ID=theta-cell-499613-r8

# GSC property — use exact URL prefix or domain property
# Examples: https://www.perugrandtravel.com/  or  sc-domain:perugrandtravel.com
PGT_GSC_PROPERTY=https://www.perugrandtravel.com/

# Optional: all active language markets (comma-separated)
# PGT_GSC_PROPERTIES=https://www.perugrandtravel.com/,https://www.machupicchupacotes.com/,https://www.viajesmachupicchutours.com/,https://www.viaggiomachupicchu.it/

# GA4 property numeric ID (Admin → Property settings)
PGT_GA4_PROPERTY_ID=368486554

# OAuth for Drive MCP — names required by @isaacphi/mcp-gdrive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CLIENT_ID=
CLIENT_SECRET=

# GTM — account path from tagmanager.google.com (Admin → Account settings)
# Format: accounts/1234567
PGT_GTM_ACCOUNT_PATH=

# OTAS / Tarifario sheet ID (capa A precios — UN sheet, no PAQUETES MODELO)
# PAQUETES MODELO = muchas carpetas xlsx/pptx — ver pgt/04-producto/DRIVE-PAQUETES-MODELO.md
PGT_OTAS_SPREADSHEET_ID=
